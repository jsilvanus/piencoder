{
  "name": "piencoder",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "description": "Multi-unit hardware streaming encoder controller service in the Raspberry Pi production ecosystem",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@jsilvanus/matrox-monarch-control": "^0.6.0",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist",
    "bin"
  ],
  "pi": {
    "service": "piencoder",
    "displayName": "piencoder",
    "port": 3104,
    "healthEndpoint": "/health",
    "envPortVar": "PIENCODER_PORT"
  }
}
